{
  "name": "shop-manager-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "店铺商品管理系统 — 后端（采集/分类/SQLite）M1 地基",
  "scripts": {
    "db:init": "tsx server/db/init.ts",
    "collect": "tsx server/collect.ts",
    "collect:manual": "tsx server/collect-manual.ts",
    "migrate:kinds": "tsx server/migrate-source-kinds.ts",
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "restart": "(lsof -ti:3000 | xargs kill 2>/dev/null || true); sleep 1; npm start",
    "build:web": "npm --prefix web install && npm --prefix web run build",
    "setup": "npm install && npm run build:web && npm run db:init",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/static": "^8.3.0",
    "better-sqlite3": "^11.8.1",
    "fastify": "^5.9.0",
    "playwright-core": "^1.49.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "node-gyp": "^11.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
