# 复制为 .env 后按需修改。已存在的环境变量优先于本文件。

# ---- 服务 ----
PORT=3000
# 仅本机可访问；若由 Nginx 反代则保持 127.0.0.1，切勿直接暴露公网
HOST=127.0.0.1
# 数据库路径。务必放本地磁盘，不要放网盘/NFS（SQLite 随机读写会损坏）
SHOP_DB_PATH=/opt/shop-manager/data/shop.db

# ---- 定时采集 ----
# 全量采集间隔（分钟）。0 = 不定时采集（默认）；下限 5 分钟。
# 本机开发保持 0；部署到服务器后再改，例如每天一次填 1440
SHOP_COLLECT_INTERVAL_MINUTES=0
# 设为 1 则进程启动后立刻先采一次（默认等到第一个间隔到达）
SHOP_COLLECT_ON_START=0

# ---- 采集节流（默认值已按「避免被风控」调保守）----
# 同一域名的并发数。多家店铺常挂在同一域名，并发打同域名极易触发整站限流
SHOP_COLLECT_HOST_CONCURRENCY=1
# 同一域名两个「店铺」之间的间隔（毫秒）
SHOP_COLLECT_HOST_DELAY_MS=1500
# 同一域名两次 HTTP 请求的最小间隔（毫秒）。这是最关键的一项：
# 采集一个店铺内部会连打 info/categoryList/goodsList 多个接口，不限速就会瞬间打出几百个请求。
# 国内服务器 500 即可；【境外 VPS 建议 1200–1500】
SHOP_HTTP_HOST_MIN_GAP_MS=500
# 请求间隔的随机抖动上限（毫秒）。固定间隔本身是机器特征，加抖动更像真人
SHOP_HTTP_JITTER_MS=400
# 浏览器采集并发。每个无头 Chrome 约 300–600MB，小内存机器保持 1
SHOP_BROWSER_CONCURRENCY=1

# ---- 浏览器采集 ----
# 无头浏览器可执行文件路径（Linux 上通常需显式指定）
# BROWSER_PATH=/usr/bin/chromium
# 设为 0 显示浏览器窗口（仅本机调试用；服务器无桌面环境时不要开）
# BROWSER_HEADLESS=1
# 设为 1 完全禁用「HTTP 被风控后回退浏览器」
# SHOP_NO_BROWSER_FALLBACK=0
